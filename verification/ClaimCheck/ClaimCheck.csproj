  The claim check: a console program for any operating system that compiles
  src/cMD5.cs and src/cRSA.cs unchanged and checks the claims that the table
  under Reproducing in README.md lists. It needs no package.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ClaimCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The printed files, compiled as they stand in src/. -->
    <Compile Include="../../src/cMD5.cs" Link="Printed/cMD5.cs" />
    <Compile Include="../../src/cRSA.cs" Link="Printed/cRSA.cs" />
    <!-- The 344 characters of the Ciphertext field of Figure 32. -->
    <None Include="../figure-32-ciphertext.txt" Link="figure-32-ciphertext.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
