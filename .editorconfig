# SPDX-License-Identifier: MIT

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets}]
indent_size = 2

[*.{yml,yaml,json,jsonc,toml,cff}]
indent_size = 2

# The code of the appendix files keeps the bytes of the author's files of
# 2021, stored with LF line endings and without a byte order mark, including
# a trailing blank in src/cRSA.cs; an editor must not trim them.
[src/{cMD5.cs,cRSA.cs,Raven One.cs}]
trim_trailing_whitespace = false
