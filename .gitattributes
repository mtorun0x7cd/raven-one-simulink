# Normalize line endings for all text files
* text=auto eol=lf

# C# / .NET sources -- enforce LF
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf

# Markup & configuration -- enforce LF
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.svg      text eol=lf
*.cff      text eol=lf

# Editor/Git configs
.editorconfig   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary assets
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
