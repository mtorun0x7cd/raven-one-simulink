# Text files are stored with LF line endings.
* text=auto eol=lf

*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.cff      text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.svg      text eol=lf
*.txt      text eol=lf

# Binary files.
*.pdf   binary
*.png   binary
*.jpg   binary

# The version of record and its checksums are stored byte for byte.
publication/** -text -diff
